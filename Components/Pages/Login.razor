@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión</PageTitle>

<div class="login-page">
    <section class="hero">
        <div class="brand">Canchas<span>Ya</span></div>
        <svg viewBox="0 0 400 240" aria-hidden="true" fill="none" stroke="#C8F169" stroke-width="3">
            <rect x="10" y="10" width="380" height="220" rx="6" />
            <line x1="200" y1="10" x2="200" y2="230" />
            <circle cx="200" cy="120" r="40" />
            <rect x="10" y="70" width="60" height="100" />
            <rect x="330" y="70" width="60" height="100" />
        </svg>
        <div>
            <h1>Reserva tu cancha en minutos</h1>
            <p>Fútbol, básquet, vóley y tenis. Elige horario, paga y juega.</p>
        </div>
    </section>

    <section class="form-wrap">
        <EditForm Model="model" OnValidSubmit="SubmitAsync" class="form">
            <DataAnnotationsValidator />
            <div>
                <h2>Iniciar sesión</h2>
                <p class="sub">Ingresa para ver y gestionar tus reservas.</p>
            </div>

            <div class="group">
                <label for="username">Correo electrónico</label>
                <InputText id="username" @bind-Value="model.Username" class="field"
                           placeholder="tucorreo@ejemplo.com" autocomplete="username" />
                <ValidationMessage For="() => model.Username" class="err" />
            </div>

            <div class="group">
                <label for="password">Contraseña</label>
                <InputText id="password" type="password" @bind-Value="model.Password" class="field"
                           placeholder="••••••••" autocomplete="current-password" />
                <ValidationMessage For="() => model.Password" class="err" />
            </div>

            <div class="opciones">
                <label class="check"><InputCheckbox @bind-Value="model.RememberMe" /> Recordarme</label>
                <a href="recuperar">¿Olvidaste tu contraseña?</a>
            </div>

            @if (error is not null)
            {
                <div class="aviso" role="alert">@error</div>
            }

            <button type="submit" class="btn-entrar" disabled="@loading">
                @(loading ? "Entrando…" : "Entrar")
            </button>

            <div class="foot">¿No tienes cuenta? <a href="registro">Regístrate</a></div>
        </EditForm>
    </section>
</div>

@code {
    private readonly LoginRequest model = new();
    private bool loading;
    private string? error;

    private async Task SubmitAsync()
    {
        loading = true;
        error = null;
        var (ok, err) = await Auth.LoginAsync(model);
        loading = false;

        if (ok) Nav.NavigateTo("/dashboard");
        else error = err;
    }
}